# Copy this file to .env and fill only the settings you use.
# Never commit .env or real credentials.
DATASET_DIR=

# Speech provider (required only for live speech I/O)
GNANI_API_KEY=

# Optional LLM response wording
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_CACHE=1
LLM_CACHE_DIR=.cache/llm
LLM_RETRIES=4
LLM_MIN_INTERVAL=0

# Optional embedding configuration
EMBED_PROVIDER=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_BASE_URL=
EMBED_CACHE_DIR=.cache/embed

# Optional local/runtime controls
VOICEOPS_NO_ENV_LOAD=0
VOICEOPS_ENABLE_HYBRID_RAG=0
